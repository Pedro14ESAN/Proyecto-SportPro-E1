rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isAdmin() {
      return signedIn() && userData().role == "ADM";
    }

    function isCoach() {
      return signedIn() && userData().role == "DT";
    }

    // =========================
    // USUARIOS
    // =========================
    match /users/{userId} {

      // Un usuario solo puede crear su propio perfil
      allow create: if signedIn()
      && request.auth.uid == userId;

      // El usuario puede ver su perfil.
      // El administrador también puede consultar usuarios.
      allow read: if signedIn()
      && (
        request.auth.uid == userId
        || isAdmin()
      );

      // El usuario puede actualizar sus datos,
      // pero no cambiarse a sí mismo de rol.
      allow update: if signedIn()
      && (
        isAdmin()
        ||
        (
          request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
        )
      );

      allow delete: if false;
    }

    // =========================
    // ACADEMIAS
    // =========================
    match /academies/{academyId} {

      allow read: if signedIn();

      allow create, update: if isAdmin();

      allow delete: if false;
    }

    // =========================
    // EQUIPOS
    // =========================
    match /teams/{teamId} {

      allow read: if signedIn();

      allow create: if isAdmin()
      || (
        isCoach()
        && request.resource.data.coachUid == request.auth.uid
      );

      allow update: if isAdmin()
      || (
        isCoach()
        && resource.data.coachUid == request.auth.uid
      );

      allow delete: if false;
    }

    // =========================
    // JUGADORES
    // =========================
    match /players/{playerId} {

      allow read: if signedIn();

      allow create, update: if isAdmin() || isCoach();

      allow delete: if false;
    }

    // =========================
    // ENTRENAMIENTOS
    // =========================
    match /trainings/{trainingId} {

      allow read: if signedIn();

      allow create: if isAdmin()
      || (
        isCoach()
        && request.resource.data.coachUid == request.auth.uid
      );

      allow update: if isAdmin()
      || (
        isCoach()
        && resource.data.coachUid == request.auth.uid
      );

      allow delete: if false;
    }

    // =========================
    // ASISTENCIA
    // =========================
    match /attendance/{attendanceId} {

      allow read: if signedIn();

      allow create, update: if isAdmin() || isCoach();

      allow delete: if false;
    }

    // =========================
    // BLOQUEO GENERAL
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}