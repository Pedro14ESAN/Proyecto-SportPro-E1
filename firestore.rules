rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // FUNCIONES AUXILIARES
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isAdmin() {
      return signedIn() && userData().role == "ADM";
    }

    function isCoach() {
      return signedIn() && userData().role == "DT";
    }

    function isPlayer() {
      return signedIn() && userData().role == "JUG";
    }

    function isParent() {
      return signedIn() && userData().role == "PAD";
    }


    // =========================================================
    // USUARIOS
    // =========================================================

    match /users/{userId} {

      // Un usuario autenticado puede crear únicamente
      // su propio documento.
      //
      // ADM no puede ser autoasignado desde la aplicación.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role in ["JUG", "PAD", "DT"];

      // El usuario puede consultar su propio perfil.
      // El administrador puede consultar usuarios.
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      // El usuario puede actualizar su perfil,
      // pero no cambiar su UID ni su rol.
      // El administrador sí puede administrar los perfiles.
      allow update: if signedIn()
        && (
          isAdmin()
          ||
          (
            request.auth.uid == userId
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role
          )
        );

      // No borramos usuarios físicamente.
      allow delete: if false;
    }


    // =========================================================
    // ACADEMIAS
    // =========================================================

    match /academies/{academyId} {

      allow read: if signedIn();

      allow create, update: if isAdmin();

      allow delete: if false;
    }


    // =========================================================
    // EQUIPOS
    // =========================================================

    match /teams/{teamId} {

      // Usuarios autenticados pueden consultar equipos.
      allow read: if signedIn();

      // ADM puede crear equipos.
      // DT puede crear equipos asignados a él mismo.
      allow create: if isAdmin()
        ||
        (
          isCoach()
          && request.resource.data.coachUid == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
        );

      // ADM puede modificar cualquier equipo.
      //
      // DT solo puede modificar equipos donde él
      // sea actualmente el entrenador.
      // No puede cambiar academyId ni id.
      allow update: if isAdmin()
        ||
        (
          isCoach()
          && resource.data.coachUid == request.auth.uid
          && request.resource.data.id == resource.data.id
          && request.resource.data.academyId == resource.data.academyId
        );

      // No se eliminan equipos.
      // Se utiliza active = false.
      allow delete: if false;
    }


    // =========================================================
    // RESERVA DE NOMBRES DE EQUIPO
    // Evita equipos duplicados
    // =========================================================

    match /team_keys/{keyId} {

      // TeamRepository usa get() dentro de una transacción
      // para comprobar si una combinación ya existe.
      allow get: if isAdmin() || isCoach();

      // No permitimos obtener la lista completa de claves.
      allow list: if false;

      // ADM y DT pueden reservar una clave.
      //
      // Solo permitimos exactamente:
      // teamId
      // academyId
      allow create: if (isAdmin() || isCoach())
        && request.resource.data.keys().hasOnly([
          "teamId",
          "academyId"
        ])
        && request.resource.data.teamId is string
        && request.resource.data.academyId is string;

      // Una key existente no se edita.
      allow update: if false;

      // Se elimina únicamente cuando cambia
      // nombre/categoría y TeamRepository reemplaza la key.
      allow delete: if isAdmin() || isCoach();
    }


    // =========================================================
    // JUGADORES
    // =========================================================

    match /players/{playerId} {

      allow read: if signedIn();

      allow create, update: if isAdmin() || isCoach();

      // Se usa active = false para mantener historial.
      allow delete: if false;
    }


    // =========================================================
    // ENTRENAMIENTOS
    // =========================================================

    match /trainings/{trainingId} {

      allow read: if signedIn();

      allow create: if isAdmin()
        ||
        (
          isCoach()
          && request.resource.data.coachUid == request.auth.uid
        );

      allow update: if isAdmin()
        ||
        (
          isCoach()
          && resource.data.coachUid == request.auth.uid
          && request.resource.data.teamId == resource.data.teamId
          && request.resource.data.academyId == resource.data.academyId
        );

      allow delete: if false;
    }


    // =========================================================
    // ASISTENCIA
    // =========================================================

    match /attendance/{attendanceId} {

      allow read: if signedIn();

      allow create, update: if isAdmin() || isCoach();

      allow delete: if false;
    }


    // =========================================================
    // PARTIDOS
    // =========================================================

    match /matches/{matchId} {

      // Usuarios autenticados pueden consultar partidos.
      allow read: if signedIn();

      // ADM puede crear cualquier partido.
      // DT puede crear partidos registrados por él.
      allow create: if isAdmin()
        ||
        (
          isCoach()
          && request.resource.data.createdBy == request.auth.uid
        );

      // ADM y DT pueden actualizar partidos.
      allow update: if isAdmin() || isCoach();

      // Conservamos historial.
      allow delete: if false;


      // =======================================================
      // EVENTOS DEL PARTIDO
      // matches/{matchId}/events/{eventId}
      // =======================================================

      match /events/{eventId} {

        // Timeline visible para usuarios autenticados.
        allow read: if signedIn();

        // ADM o DT registran eventos.
        allow create: if isAdmin() || isCoach();

        // Correcciones y anulaciones.
        allow update: if isAdmin() || isCoach();

        // Nunca eliminamos eventos físicamente.
        // Se utiliza status = ANNULLED.
        allow delete: if false;
      }
    }


    // =========================================================
    // RESÚMENES GENERADOS POR IA
    // =========================================================

    match /ai_summaries/{summaryId} {

      allow read: if signedIn();

      // Durante el desarrollo:
      // ADM o DT pueden crear el documento.
      //
      // En la versión final la generación debe
      // ejecutarse mediante backend seguro.
      allow create: if isAdmin() || isCoach();

      // DT y ADM pueden revisar/aprobar.
      allow update: if isAdmin() || isCoach();

      // Conservamos trazabilidad.
      allow delete: if false;
    }


    // =========================================================
    // BLOQUEO GENERAL
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}